# Шаблон переменных окружения. Настоящие значения хранятся только:
#  - на Vercel: Project → Settings → Environment Variables;
#  - для локального запуска: в файле .env.local (он не попадает в репозиторий).

# PIN-код для входа в приложение: 4–12 цифр, рекомендуется 6 и больше.
APP_PIN=

# Секрет для подписи cookie после входа: случайная строка не короче 32 символов.
# После смены APP_PIN или SESSION_SECRET все открытые сессии завершаются.
SESSION_SECRET=

# Supabase → Project Settings → Data API (Project URL), например https://abcdefgh.supabase.co
SUPABASE_URL=

# Supabase → Project Settings → API Keys → Secret key (sb_secret_…).
# Используется только на сервере; никогда не публикуйте его и не добавляйте префикс NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# AI-провайдер для тренировки (ET-15). Пусто — тестовая заглушка: фразы-шаблоны и простая проверка.
AI_PROVIDER=
